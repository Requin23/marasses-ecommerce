# Local PostgreSQL in Docker (default)
DATABASE_URL=postgresql+psycopg://marasses:marasses@db:5432/marasses
# For Supabase, replace DATABASE_URL with the URI from Project > Connect.
# Keep this .env file private; never commit real database credentials.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# GeniusPay Sandbox. Set these only in your private .env file.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_ENVIRONMENT=sandbox
APP_PUBLIC_URL=http://localhost:3000
